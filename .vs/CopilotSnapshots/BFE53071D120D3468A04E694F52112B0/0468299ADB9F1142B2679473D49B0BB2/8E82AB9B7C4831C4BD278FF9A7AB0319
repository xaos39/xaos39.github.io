:root{--accent:#0077b6;--accent-2:#00b4d8;--dark:#073b4c;--muted:#6c7a89}
:root{--accent:#0077b6;--accent-2:#00b4d8;--dark:#073b4c;--muted:#6c7a89}
*{box-sizing:border-box}
body{font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; margin:0; color:var(--dark); line-height:1.45; -webkit-font-smoothing:antialiased}
a{color:inherit; text-decoration:none}
html,body{overflow-x:hidden}

/* Topbar */
.topbar{background:linear-gradient(90deg,var(--accent),var(--accent-2)); color:#fff}

/* Header / nav */
header{position:sticky; top:0; z-index:60; background:rgba(255,255,255,0.92); backdrop-filter:saturate(120%) blur(6px); border-bottom:1px solid rgba(7,59,76,0.06)}
.container{max-width:1180px; margin:0 auto; padding:0 20px}
.nav{display:flex; align-items:center; justify-content:space-between; height:72px}
.logo{display:flex; align-items:center; gap:12px; font-weight:700; color:var(--dark)}
.logo .mark{width:46px; height:46px; border-radius:8px; background:linear-gradient(135deg,var(--accent),var(--accent-2)); display:inline-flex; align-items:center; justify-content:center; color:white; font-weight:700}
nav ul{display:flex; gap:18px; align-items:center; margin:0; padding:0; list-style:none}
nav ul li a{padding:8px 6px; color:var(--dark); font-weight:600}
.cta{background:var(--accent); color:#fff; padding:10px 16px; border-radius:8px}
.cta.small{padding:8px 12px;font-size:14px}

/* Hero */
.hero-large{
  background-image:linear-gradient(180deg, rgba(1,33,45,0.85), rgba(0,86,120,0.75));
  color:#fff;
  position:relative;
  /* пусть секция занимает всю доступную ширину страницы без смещений */
  width:100%;
  padding:0;
}
.hero-overlay{
  background:linear-gradient(90deg, rgba(2,27,33,0.15), rgba(0,0,0,0.05));
  padding:80px 0; /* вертикальные отступы для хиро-секции */
}
h1{margin:0}
.actions{display:flex; gap:12px}
.outline{display:inline-flex;align-items:center;border-radius:8px;padding:10px 14px;border:1px solid rgba(255,255,255,0.18);color:#fff}
.card{background:#fff; border-radius:12px; padding:20px; box-shadow:0 10px 30px rgba(2,27,33,0.08); color:var(--dark)}
.card.small{padding:10px;border-radius:10px}

.trust .card.small{background:rgba(255,255,255,0.08);color:#fff;border:none;box-shadow:none}

/* Sections */
section{padding:56px 0}
.grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
.service{background:linear-gradient(180deg,#fff,#fbfdff); border-radius:12px; padding:18px; border:1px solid rgba(7,59,76,0.04)}

.process{display:flex; gap:14px; flex-wrap:wrap}
.step{flex:1 1 200px; background:#f7fbfc; padding:18px; border-radius:10px}

/* Testimonials */
.testimonials{display:grid; grid-template-columns:repeat(2,1fr); gap:16px}

/* Contact */
.contact{display:grid; grid-template-columns:1fr 380px; gap:24px}
form input, form textarea{width:100%; padding:10px; border:1px solid rgba(7,59,76,0.08); border-radius:8px}
button[type=submit]{background:var(--accent); color:#fff; border:none; padding:12px 16px; border-radius:8px; cursor:pointer}

footer{padding:30px 0; background:#021d26; color:#cfeefb}

/* Responsive */
@media (max-width:1000px){
  .grid-3{grid-template-columns:1fr}
  .testimonials{grid-template-columns:1fr}
  .contact{grid-template-columns:1fr}
  nav ul{display:none}
  .hero-large .container{padding:40px 20px}
}

